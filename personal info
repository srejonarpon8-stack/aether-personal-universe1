<style>
:root {
--bg:#070914;
--panel:#10162a;
--ink:#f4f5ff;
--muted:#9aa3bf;
--soft:#c6cbe0;
--line:#ffffff20;
--blue:#83a7ff;
--violet:#a78bfa;
--cyan:#67e8f9;
--mono:"DM Mono",monospace;
--display:"Space Grotesk",sans-serif;
--body:"Manrope",sans-serif;
--g:clamp(20px,5vw,76px);
}

*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:90px;background:var(--bg)}
body{
margin:0;
background:radial-gradient(ellipse at 80% 0%,#19204a55,transparent 38%),var(--bg);
color:var(--ink);
font-family:var(--body);
overflow-x:hidden
}
body:before{
content:"";
position:fixed;
inset:0;
pointer-events:none;
z-index:20;
opacity:.1;
background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.18'/%3E%3C/svg%3E")
}

a{color:inherit;text-decoration:none}
button,input,textarea{font:inherit}
.mono,.eyebrow{font:10px var(--mono);letter-spacing:.14em;text-transform:uppercase}
.mono,.muted{color:var(--muted)}
.eyebrow{color:var(--blue)}
.wrap{width:min(1440px,100%);margin:auto;padding-left:var(--g);padding-right:var(--g)}
.section{padding-top:105px;padding-bottom:110px;border-top:1px solid var(--line)}
.head{display:flex;justify-content:space-between;gap:20px;color:var(--muted);font:10px var(--mono);letter-spacing:.13em;text-transform:uppercase}
.title{font:600 clamp(42px,7vw,92px)/.98 var(--display);letter-spacing:-.065em;margin:34px 0 24px}
.title em{font-style:normal;color:var(--blue)}
.pill{display:inline-flex;gap:8px;border:1px solid var(--line);border-radius:99px;padding:9px 13px;color:var(--soft);font:10px var(--mono);text-transform:uppercase;background:#ffffff08}
.btn{display:inline-flex;gap:12px;align-items:center;padding:14px 18px;border-radius:99px;border:1px solid #93aaff66;background:linear-gradient(110deg,#789aff25,#a78bfa1c);font:10px var(--mono);letter-spacing:.09em;text-transform:uppercase;transition:.3s;cursor:pointer}
.btn:hover{transform:translateY(-3px);border-color:var(--blue);box-shadow:0 10px 40px #647dff25}
.secondary{background:transparent;border-color:var(--line)}
.reveal{opacity:0;transform:translateY(24px);transition:.8s}
.reveal.show{opacity:1;transform:none}

.intro{position:fixed;inset:0;z-index:100;background:#070914;display:grid;place-items:center;animation:out .8s 1.7s forwards;pointer-events:none;text-align:center}
.intro b{font:700 clamp(50px,12vw,130px) var(--display);letter-spacing:-.1em;background:linear-gradient(100deg,#fff,#91aaff,#c4a5ff);background-clip:text;color:transparent}
.intro i{display:block;width:min(260px,60vw);height:2px;background:linear-gradient(90deg,var(--blue),var(--violet));margin:22px auto;animation:load 1.3s both}
.intro small{font:9px var(--mono);letter-spacing:.2em;color:var(--muted)}
@keyframes out{to{opacity:0;visibility:hidden}}
@keyframes load{from{transform:scaleX(0);transform-origin:left}to{transform:scaleX(1)}}

header{height:78px;position:fixed;z-index:50;inset:0 0 auto;display:flex;align-items:center;justify-content:space-between;padding:0 var(--g);background:linear-gradient(#070914ed,#070914a8,transparent);backdrop-filter:blur(12px)}
.brand{font:700 17px var(--display);letter-spacing:.17em}
.brand b{color:var(--blue)}
.brand small{font:9px var(--mono);color:var(--muted);letter-spacing:.1em;margin-left:8px}
.nav{display:flex;align-items:center;gap:25px}
.nav a,.menu a{font:10px var(--mono);letter-spacing:.09em;text-transform:uppercase;color:var(--muted);transition:.2s}
.nav a:hover,.menu a:hover{color:white}
.nav .nav-cta{padding:10px 14px;border:1px solid var(--line);border-radius:99px;color:white}
.menu-btn{display:none;background:#10162a;border:1px solid var(--line);padding:10px 13px;border-radius:30px;font:10px var(--mono);color:white}
.menu{display:none;position:absolute;top:68px;right:var(--g);width:min(300px,calc(100vw - 40px));padding:15px 20px;background:#10162a;border:1px solid var(--line);border-radius:16px}
.menu.open{display:grid}
.menu a{padding:14px 0;border-bottom:1px solid var(--line)}
.menu a:last-child{border:0}

.hero{height:100svh;min-height:760px;max-height:1100px;position:relative;display:flex;flex-direction:column;justify-content:space-between;padding-top:135px;padding-bottom:36px;overflow:hidden}
.gridbg{position:absolute;inset:0;opacity:.23;background-image:linear-gradient(#7586ff12 1px,transparent 1px),linear-gradient(90deg,#7586ff12 1px,transparent 1px);background-size:70px 70px;mask-image:linear-gradient(to bottom,black,transparent 85%)}
#particles{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}
.hero-top,.hero-bottom{display:flex;justify-content:space-between;align-items:center;gap:20px;position:relative;z-index:2}
.hero-center{position:absolute;inset:18% 0 13%;display:grid;place-items:center;text-align:center}
.orb-wrap{position:absolute;width:min(60vw,650px);aspect-ratio:1;display:grid;place-items:center;animation:float 8s ease-in-out infinite;transform-style:preserve-3d}
.orb{width:35%;aspect-ratio:1;border-radius:36%;background:radial-gradient(circle at 30% 25%,#fff,#c9d6ff 8%,#829dff 20%,#4444a2 48%,#151b43 72%,#0a0c20);box-shadow:inset -25px -30px 50px #050719,inset 12px 12px 30px #ffffff99,0 0 80px #778dff66,0 0 180px #6554e044;transform:rotate(35deg);animation:pulse 5s infinite}
.orbit{position:absolute;width:76%;height:28%;border:1px solid #b8caff88;border-radius:50%;transform:rotate(-27deg);box-shadow:0 0 25px #89aaff2b}
.orbit.two{width:90%;height:43%;transform:rotate(56deg);border-color:#a78bfa88}
.orbit.three{width:105%;height:20%;transform:rotate(82deg);border-color:#67e8f955}
.glow{position:absolute;width:60%;height:60%;border-radius:50%;background:#596eff22;filter:blur(55px)}
@keyframes float{50%{transform:translateY(-20px) rotateY(8deg)}}
@keyframes pulse{50%{box-shadow:inset -25px -30px 50px #050719,inset 12px 12px 30px #ffffff99,0 0 110px #778dff99,0 0 220px #6554e066}}
.hero-title{position:relative;z-index:2;font:700 clamp(72px,17vw,230px)/.78 var(--display);letter-spacing:-.105em;margin:0;background:linear-gradient(180deg,#fff 5%,#cbd5ff 55%,#8398ff);background-clip:text;color:transparent}
.hero-title span{display:inline-block;animation:letter .9s both;animation-delay:calc(var(--i)*.08s)}
@keyframes letter{from{opacity:0;transform:translateY(80px) rotate(8deg);filter:blur(8px)}to{opacity:1;transform:none;filter:none}}
.tagline{position:relative;z-index:3;margin-top:30px;font:500 clamp(16px,2.1vw,25px)/1.45 var(--display);color:#dce2ff}
.tagline em{font-style:normal;color:var(--blue)}
.actions{display:flex;gap:12px;justify-content:center;margin-top:26px;flex-wrap:wrap}
.hero-desc{max-width:460px;text-align:left;color:var(--muted);font-size:13px;line-height:1.8}
.scroll{color:var(--muted);font:10px var(--mono)}
.scroll i{color:var(--blue);font-style:normal;font-size:18px}

.about-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:8vw;align-items:start;margin-top:70px}
.portrait{min-height:300px;border:1px solid var(--line);border-radius:22px;background:radial-gradient(circle at 50% 40%,#536bcb55,transparent 48%),linear-gradient(145deg,#171d38,#090c19);display:grid;place-items:center;position:relative;overflow:hidden}
.portrait-orb{width:145px;height:145px;border-radius:38%;background:linear-gradient(135deg,#fff,#819dff 35%,#5b48a5 75%);box-shadow:0 0 70px #7c8dff55;transform:rotate(35deg);animation:float 7s infinite}
.portrait:after{content:"S / P / A";position:absolute;bottom:18px;left:20px;font:10px var(--mono);letter-spacing:.18em;color:#b8c5ff}
.stats{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-top:12px}
.stat{border:1px solid var(--line);border-radius:14px;padding:17px;background:#ffffff05}
.stat strong{display:block;font:600 24px var(--display);color:var(--blue)}
.stat span{font:9px var(--mono);color:var(--muted);text-transform:uppercase}
.about-copy h3{font:600 clamp(27px,3.4vw,45px)/1.15 var(--display);letter-spacing:-.04em;margin:0 0 22px}
.about-copy p{color:var(--soft);font-size:15px;line-height:1.9;margin:0 0 18px}
.highlight{color:var(--blue)}
.tags{display:flex;gap:8px;flex-wrap:wrap;margin-top:28px}

.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:55px}
.card{min-height:220px;padding:25px;border:1px solid var(--line);border-radius:18px;background:linear-gradient(145deg,#151b32aa,#0b0f1e);position:relative;overflow:hidden;transition:.35s}
.card:before{content:"";position:absolute;width:180px;height:180px;border-radius:50%;right:-90px;top:-90px;background:#718bff1c;filter:blur(20px)}
.card:hover{transform:translateY(-7px);border-color:#839eff88}
.card-icon{font-size:25px;color:var(--blue)}
.card h3{font:600 22px var(--display);margin:28px 0 10px}
.card p{font-size:13px;line-height:1.7;color:var(--muted);max-width:330px}
.card-num{position:absolute;right:22px;top:24px;font:10px var(--mono);color:#68718e}

.skill-layout{display:grid;grid-template-columns:1fr 1fr;gap:7vw;margin-top:55px}
.skill-group{border-top:1px solid var(--line);padding-top:20px}
.skill-group h3{font:600 22px var(--display);margin:0 0 20px}
.skill{margin:18px 0}
.skill-top{display:flex;justify-content:space-between;font-size:13px;color:var(--soft);margin-bottom:9px}
.skill-top span:last-child{font:9px var(--mono);color:var(--muted);text-transform:uppercase}
.track{height:5px;background:#ffffff12;border-radius:10px;overflow:hidden}
.track i{display:block;height:100%;width:var(--w);background:linear-gradient(90deg,var(--blue),var(--violet));transform:scaleX(0);transform-origin:left;transition:transform 1.2s}
.skill-group.show .track i{transform:scaleX(1)}
.note{font:10px/1.7 var(--mono);color:var(--muted);margin-top:25px}

.timeline{margin-top:55px;max-width:900px}
.timeline-item{display:grid;grid-template-columns:125px 1fr;gap:25px;padding:25px 0;border-top:1px solid var(--line)}
.date{font:10px var(--mono);color:var(--blue);letter-spacing:.1em}
.timeline-item h3{font:600 20px var(--display);margin:0 0 8px}
.timeline-item p{font-size:13px;line-height:1.7;color:var(--muted);margin:0;max-width:650px}
.status{display:inline-block;margin-top:10px;font:9px var(--mono);color:#a5b7ff;border:1px solid #8da7ff44;border-radius:30px;padding:6px 9px;text-transform:uppercase}

.projects{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;margin-top:55px}
.project{border:1px solid var(--line);border-radius:20px;overflow:hidden;background:#0d1222;transition:.35s}
.project:hover{transform:translateY(-6px);border-color:#819bff88}
.art{height:220px;position:relative;overflow:hidden;display:grid;place-items:center;background:radial-gradient(circle at 50% 45%,#475bbd77,transparent 45%),linear-gradient(140deg,#171d3b,#090b17)}
.shape{width:115px;height:145px;border:1px solid #d8e2ff99;background:linear-gradient(135deg,#e2e8ff44,#667fff11);clip-path:polygon(50% 0,100% 24%,78% 100%,15% 86%,0 22%);transform:rotate(25deg);box-shadow:0 0 55px #7890ff55;animation:float 7s infinite}
.art.alt{background:radial-gradient(circle at 50% 50%,#714da677,transparent 46%),linear-gradient(140deg,#201632,#090b17)}
.art.alt .shape{border-radius:50%;clip-path:none;width:150px;height:150px;transform:rotateX(65deg)}
.art.third{background:radial-gradient(circle at 50% 50%,#226c8b66,transparent 48%),linear-gradient(140deg,#102638,#080c17)}
.art.third .shape{clip-path:polygon(50% 0,100% 100%,0 100%);width:160px;height:140px}
.art.fourth{background:radial-gradient(circle at 50% 50%,#6954a866,transparent 48%),linear-gradient(140deg,#211638,#080b17)}
.art.fourth .shape{width:170px;height:90px;border-radius:50%;clip-path:none}
.project-info{padding:22px}
.project-info .meta{font:9px var(--mono);color:var(--blue);letter-spacing:.1em;text-transform:uppercase}
.project-info h3{font:600 22px var(--display);margin:10px 0}
.project-info p{font-size:13px;color:var(--muted);line-height:1.7;margin:0}

.faith-panel{margin-top:55px;border:1px solid #9c8bff44;border-radius:24px;padding:clamp(25px,5vw,55px);background:radial-gradient(ellipse at 90% 10%,#8b72ff22,transparent 45%),linear-gradient(135deg,#17172f,#0b1020);position:relative;overflow:hidden}
.faith-panel:after{content:"✦";position:absolute;right:7%;top:4%;font-size:clamp(90px,15vw,190px);color:#c6b8ff0c}
.faith-quote{font:500 clamp(25px,4vw,47px)/1.25 var(--display);letter-spacing:-.04em;max-width:850px;margin:30px 0}
.faith-quote em{font-style:normal;color:#c4b4ff}
.faith-panel p{color:#c0c2d9;line-height:1.8;font-size:14px;max-width:700px}
.verse{font:10px var(--mono);color:#c4b4ff;letter-spacing:.1em;margin-top:25px}

.journal-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:14px;margin-top:55px}
.journal-feature,.journal-side{border:1px solid var(--line);border-radius:18px;background:#ffffff05;padding:25px}
.journal-feature h3{font:600 clamp(25px,4vw,42px)/1.1 var(--display);margin:18px 0}
.journal-feature p,.journal-side p{font-size:13px;line-height:1.7;color:var(--muted)}
.journal-side a{display:block;padding:17px 0;border-bottom:1px solid var(--line);font-size:14px}
.journal-side a:last-child{border:0}

.tools{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:45px}
.tool{border:1px solid var(--line);border-radius:14px;padding:17px;background:#ffffff05;transition:.25s}
.tool:hover{border-color:#839eff88;transform:translateY(-4px)}
.tool b{display:block;font:600 15px var(--display);margin-bottom:7px}
.tool span{font:9px var(--mono);color:var(--muted);text-transform:uppercase}

.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:8vw;margin-top:45px}
.contact-copy{font-size:15px;line-height:1.8;color:var(--muted);max-width:420px}
.contact-copy strong{color:white}
.form{display:grid;gap:16px}
.form label{font:9px var(--mono);letter-spacing:.12em;color:var(--muted)}
.form input,.form textarea{display:block;width:100%;margin-top:9px;background:#ffffff08;border:1px solid var(--line);border-radius:10px;padding:14px;color:white;outline:none;resize:vertical}
.form input:focus,.form textarea:focus{border-color:var(--blue)}
.footer{border-top:1px solid var(--line);padding-top:28px;padding-bottom:35px;display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap}
.footer-note{font:9px var(--mono);color:var(--muted);letter-spacing:.1em}
.back{font:10px var(--mono);color:var(--blue)}
.cursor{position:fixed;width:280px;height:280px;border-radius:50%;pointer-events:none;z-index:0;background:radial-gradient(circle,#718aff10,transparent 68%);transform:translate(-50%,-50%)}

@media(max-width:850px){
.nav{display:none}
.menu-btn{display:block}
.about-grid{grid-template-columns:1fr;gap:35px}
.portrait{min-height:240px}
.cards{grid-template-columns:1fr 1fr}
.skill-layout{gap:35px}
.tools{grid-template-columns:repeat(2,1fr)}
}

@media(max-width:600px){
.hero{min-height:740px;padding-top:115px}
.hero-center{inset:25% 0 20%}
.hero-title{font-size:clamp(66px,18vw,110px)}
.orb-wrap{width:95vw}
.hero-bottom{align-items:flex-end}
.hero-desc{font-size:11px;max-width:210px}
.hide-mobile{display:none}
.section{padding-top:75px;padding-bottom:80px}
.head span:last-child{max-width:130px;text-align:right}
.title{font-size:clamp(43px,12vw,66px)}
.about-grid{margin-top:45px}
.cards{grid-template-columns:1fr}
.card{min-height:190px}
.skill-layout{grid-template-columns:1fr}
.timeline-item{grid-template-columns:85px 1fr;gap:12px}
.projects{grid-template-columns:1fr}
.art{height:190px}
.journal-grid,.contact-grid{grid-template-columns:1fr}
.tools{grid-template-columns:1fr 1fr}
.footer{align-items:flex-start;flex-direction:column}
}

@media(prefers-reduced-motion:reduce){
*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;scroll-behavior:auto!important}
.reveal{opacity:1;transform:none}
}
</style>
</head>

