<script>
const $=s=>document.querySelector(s);
$('#year').textContent=new Date().getFullYear();

const mb=$('#menuBtn'),menu=$('#menu');
mb.addEventListener('click',()=>{
menu.classList.toggle('open');
mb.textContent=menu.classList.contains('open')?'CLOSE −':'MENU +';
});

menu.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{
menu.classList.remove('open');
mb.textContent='MENU +';
}));

const title=$('#heroTitle');
title.innerHTML=[...title.textContent].map((c,i)=>`<span style="--i:${i}">${c}</span>`).join('');

const io=new IntersectionObserver(es=>es.forEach(e=>{
if(e.isIntersecting){
e.target.classList.add('show');
io.unobserve(e.target);
}
}),{threshold:.13});

document.querySelectorAll('.reveal,.skill-group').forEach(x=>io.observe(x));

const cursor=$('#cursor'),orb=$('#orb');
window.addEventListener('pointermove',e=>{
cursor.style.left=e.clientX+'px';
cursor.style.top=e.clientY+'px';
const x=e.clientX/innerWidth-.5,y=e.clientY/innerHeight-.5;
orb.style.marginLeft=x*18+'px';
orb.style.marginTop=y*12+'px';
},{passive:true});

const canvas=$('#particles'),ctx=canvas.getContext('2d');
let pts=[],w,h;

function resize(){
let d=Math.min(devicePixelRatio||1,2);
w=canvas.clientWidth;
h=canvas.clientHeight;
canvas.width=w*d;
canvas.height=h*d;
ctx.setTransform(d,0,0,d,0,0);
pts=Array.from({length:Math.min(85,Math.floor(w/14))},()=>({
x:Math.random()*w,
y:Math.random()*h,
vx:(Math.random()-.5)*.22,
vy:(Math.random()-.5)*.22,
r:Math.random()*1.5+.3
}));
}

function draw(){
ctx.clearRect(0,0,w,h);
pts.forEach((p,i)=>{
p.x+=p.vx;
p.y+=p.vy;
if(p.x<0||p.x>w)p.vx*=-1;
if(p.y<0||p.y>h)p.vy*=-1;
ctx.beginPath();
ctx.arc(p.x,p.y,p.r,0,7);
ctx.fillStyle='rgba(169,190,255,.65)';
ctx.fill();

for(let j=i+1;j<pts.length;j++){
let q=pts[j],d=Math.hypot(p.x-q.x,p.y-q.y);
if(d<115){
ctx.beginPath();
ctx.moveTo(p.x,p.y);
ctx.lineTo(q.x,q.y);
ctx.strokeStyle=`rgba(130,157,255,${(1-d/115)*.12})`;
ctx.stroke();
}
}
});
requestAnimationFrame(draw);
}

if(!matchMedia('(prefers-reduced-motion: reduce)').matches){
resize();
draw();
addEventListener('resize',resize);
}

// Replace this with your public contact email to enable the mail-app draft.
const CONTACT_EMAIL='YOUR_EMAIL@example.com';

$('#contactForm').addEventListener('submit',e=>{
e.preventDefault();

if(CONTACT_EMAIL==='YOUR_EMAIL@example.com'){
alert('The form is ready, but the owner email is not configured yet. Replace YOUR_EMAIL@example.com in the HTML with your public email address.');
return;
}

let n=$('#senderName').value.trim(),
em=$('#senderEmail').value.trim(),
m=$('#senderMessage').value.trim();

location.href=`mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent('AETHER message from '+n)}&body=${encodeURIComponent(m+'\\n\\nFrom: '+n+'\\nReply to: '+em)}`;
});
</script>

